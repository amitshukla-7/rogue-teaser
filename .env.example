# Database Connection String (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Google OAuth Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin API Authorization Secret Key
ADMIN_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Optional Public API URL (Leave blank for same-origin relative API calls)
NEXT_PUBLIC_API_URL=
